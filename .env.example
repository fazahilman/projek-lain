# Wajib: kunci Anthropic API untuk membaca & menerjemahkan isi laporan.
ANTHROPIC_API_KEY=sk-ant-...

# Opsional: ganti model yang dipakai (default: claude-opus-5).
# ANTHROPIC_MODEL=claude-opus-5

# Penyimpanan riwayat & catatan.
# Isi salah satu pasangan berikut (Vercel KV / Upstash Redis lewat REST).
# Kalau kosong, aplikasi tetap jalan tetapi riwayat hanya disimpan di memori
# proses dan akan hilang saat server restart (cukup untuk coba-coba lokal).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
